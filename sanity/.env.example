# Sanity Studio environment variables — copy this file to .env and fill in real values.
# The Studio reads these when you run `npm run studio` (it runs with sanity/ as its working directory).

# Your Sanity project ID (dashboard.sanity.io → Project settings → API)
VITE_SANITY_PROJECT_ID=your-project-id

# Dataset name (defaults to "production" if omitted)
VITE_SANITY_DATASET=production