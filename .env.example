# Copy this file to `.env` and fill in your Sanity project values.
# `.env` is gitignored — never commit real values.

# Sanity project ID (dashboard.sanity.io → Project settings → API)
VITE_SANITY_PROJECT_ID=your-project-id

# Dataset name (defaults to "production" if omitted)
VITE_SANITY_DATASET=production

# Optional: pin the Sanity API version (defaults to "2024-06-04" in src/lib/sanity/client.ts)
# VITE_SANITY_API_VERSION=2024-06-04

# Meta Pixel ID (Facebook/Meta Events Manager → Data Sources → Pixels)
# This is a public, non-secret value (safe to expose in client-side code).
# Must be configured in Vercel for Production and any required Preview environments.
VITE_META_PIXEL_ID=your-meta-pixel-id

# Note: `npm run studio` runs scripts/prepare-env.mjs, which reads this file and
# writes sanity/.env with the keys renamed to SANITY_STUDIO_* for the Studio.
#
# --- Contact form (server-side only) -----------------------------------------
# These power POST /api/contact (see api/contact.ts). They are read by the
# Vercel function at runtime, never by the browser, and must NOT carry the
# VITE_ prefix. Copy this list into the Vercel project environment settings
# (Production and Preview) — never commit real values here.
#
# Resend API key (resend.com → API Keys). Sandbox keys can only send to the
# Resend account owner's own address until a sending domain is verified.
# RESEND_API_KEY=
#
# Upstash Redis REST credentials (upstash.com → Database → REST API).
# Used for rate limiting (sliding windows) and duplicate suppression.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Where contact messages are delivered (the owner's verified Resend email).
# CONTACT_RECIPIENT=
#
# From identity for outgoing mail. Sandbox stage: onboarding@resend.dev
# CONTACT_SENDER=onboarding@resend.dev
#
# Per-deployment secret used to hash visitor IPs and dedupe fingerprints
# before anything is written to Redis. Generate with: openssl rand -hex 32
# RL_SALT=
