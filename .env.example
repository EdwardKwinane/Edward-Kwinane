# Copy this file to `.env` and fill in your Sanity project values.
# `.env` is gitignored — never commit real values.

# Sanity project ID (dashboard.sanity.io → Project settings → API)
VITE_SANITY_PROJECT_ID=your-project-id

# Dataset name (defaults to "production" if omitted)
VITE_SANITY_DATASET=production

# Optional: pin the Sanity API version (defaults to 2024-06-04 in src/lib/sanity/client.ts)
# VITE_SANITY_API_VERSION=2024-06-04

# Note: `npm run studio` runs scripts/prepare-env.mjs, which reads this file and
# writes sanity/.env with the keys renamed to SANITY_STUDIO_* for the Studio.
